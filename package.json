{
  "name": "@farena/fa-editor",
  "version": "1.2.0",
  "description": "Zero-dependency rich-text editor for Vue 3, with a strict and stable HTML contract",
  "keywords": [
    "vue",
    "vue3",
    "wysiwyg",
    "rich-text",
    "editor",
    "contenteditable",
    "html"
  ],
  "license": "MIT",
  "author": "Federico Arena",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farena/fa-editor.git"
  },
  "homepage": "https://farena.github.io/fa-editor",
  "bugs": {
    "url": "https://github.com/farena/fa-editor/issues"
  },
  "type": "module",
  "main": "./dist/fa-editor.umd.cjs",
  "module": "./dist/fa-editor.js",
  "exports": {
    ".": {
      "import": "./dist/fa-editor.js",
      "require": "./dist/fa-editor.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./scss": "./src/fa-editor.scss",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist",
    "src/fa-editor.scss",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lab": "vite build --mode lab",
    "lint": "eslint . --ext .vue,.js,.cjs --ignore-path .gitignore",
    "format": "prettier --write src lab",
    "check": "npm run lint && prettier --check src lab && npm run build",
    "prepublishOnly": "npm run check",
    "release": "npm run check && npm publish"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^9.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "vite": "^5.4.11",
    "vue": "^3.5.13"
  }
}
